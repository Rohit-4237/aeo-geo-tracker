# ─── Firebase / Firestore ──────────────────────────────────────────────────────
# Option A (production / Vercel): paste the entire service-account JSON as one line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Option B (local dev): path to the downloaded service-account key file
# GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# ─── Platform-hosted API keys (optional) ──────────────────────────────────────
# Fill these in if YOU (the tool owner) want to bear the API cost for all users.
# Leave blank to require each user to enter their own keys on the Settings page.
PLATFORM_OPENAI_API_KEY=
PLATFORM_GEMINI_API_KEY=
PLATFORM_PERPLEXITY_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins. Use * to allow all (fine for local dev).
CORS_ORIGINS=*
